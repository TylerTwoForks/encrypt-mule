package templates

// TopTextarea is the plaintext input box. Put YAML here and convert to encrypt.
templ TopTextarea(content string) {
	<textarea
		style="width: 60vw; height: 40vh; margin-left: 2vw;"
		id="yaml"
		name="yaml"
		rows="10"
		cols="60"
		placeholder="Paste YAML here to encrypt..."
		hx-post="/format-yaml"
		hx-trigger="change delay:500ms"
		hx-target="#yaml"
		hx-swap="outerHTML"
	>{ content }</textarea>
}

// BottomTextarea is the ciphertext box. Put encrypted YAML here and convert to decrypt.
templ BottomTextarea(content string) {
	<textarea
		id="yaml-target"
		name="encrypted"
		rows="10"
		cols="60"
		placeholder="Paste encrypted YAML here to decrypt..."
		style="width: 60vw; height: 40vh; margin-left: 2vw;"
	>{ content }</textarea>
}

templ MainTemplate() {
	<div style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100vh;">
		@TopTextarea("")
		<br/>
		<form>
			<input type="text" id="encrypt-key" name="encrypt-key" placeholder="encryption key"/>
			<button
				hx-post="/"
				hx-include="#yaml, #yaml-target, #encrypt-key"
				hx-target="#yaml-target"
				hx-swap="outerHTML"
				style="height: 3em; margin: 0 2vw;"
			>convert</button>
		</form>
		<br/>
		@BottomTextarea("")
	</div>
}

templ ConvertError(err error) {
	<div class="alert alert-danger" style="color: red;">
		<strong>Error:</strong> { err.Error() }
	</div>
}

templ MainTempl() {
	@Base(MainTemplate())
}
